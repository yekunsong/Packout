{
  "schema_version": "2.0",
  "name": "claude-code",
  "title": "Claude Code",
  "vendor": "Anthropic",
  "applies_to": {
    "os": [
      "windows",
      "darwin",
      "linux"
    ]
  },
  "roots": {
    "home": {
      "windows": "%USERPROFILE%",
      "darwin": "$HOME",
      "linux": "$HOME"
    },
    "appdata": {
      "windows": "%APPDATA%",
      "darwin": "$HOME/Library/Application Support",
      "linux": "${XDG_CONFIG_HOME:-$HOME/.config}"
    },
    "localappdata": {
      "windows": "%LOCALAPPDATA%",
      "darwin": "$HOME/Library/Caches",
      "linux": "${XDG_CACHE_HOME:-$HOME/.cache}"
    },
    "repo": "${REPO_ROOT}"
  },
  "defaults": {
    "expand": "per-file",
    "max_depth": 32
  },
  "max_bytes_total": 274877906944,
  "entries": [
    {
      "id": "settings-global",
      "kind": "file",
      "root": "home",
      "path": ".claude/settings.json",
      "layer": "L2",
      "secret": "scan",
      "extractor": "template",
      "priority": 20,
      "redact": {
        "key_pattern": [
          "(?i).*(token|secret|password|api[_-]?key).*"
        ]
      },
      "signals": [
        {
          "src": "official_docs",
          "note": "全局用户设置，含 env 与权限配置",
          "url": "https://code.claude.com/docs/en/settings"
        }
      ]
    },
    {
      "id": "settings-backups",
      "kind": "glob-group",
      "root": "home",
      "paths": [
        ".claude/settings.json.*"
      ],
      "layer": "L2",
      "secret": "scan",
      "extractor": "template",
      "priority": 20,
      "redact": {
        "key_pattern": [
          "(?i).*(token|secret|password|api[_-]?key).*"
        ]
      },
      "signals": [
        {
          "src": "observed_behavior",
          "note": "settings.json 的手工备份与写入临时文件，与主文件同构"
        }
      ]
    },
    {
      "id": "settings-local-global",
      "kind": "file",
      "root": "home",
      "path": ".claude/settings.local.json",  // 本机不存在
      "layer": "L2",
      "secret": "scan",
      "extractor": "template",
      "unique_within": "root",
      "priority": 20,
      "redact": {
        "key_pattern": [
          "(?i).*(token|secret|password|api[_-]?key).*"
        ]
      },
      "signals": [
        {
          "src": "observed_behavior",
          "note": "Claude Code 首次写入时自动加入全局 gitignore；实测 ~/.config/git/ignore 首行为 **/.claude/settings.local.json"
        }
      ]
    },
    {
      "id": "claude-json",
      "kind": "file",
      "root": "home",
      "path": ".claude.json",
      "layer": "L2",
      "secret": "none",
      "extractor": "keys-only",
      "churn": "high",
      "max_bytes_inline": 0,
      "max_bytes_structure": 1048576,
      "max_bytes_total": 2097152,
      "priority": 30,
      "signals": [
        {
          "src": "observed_behavior",
          "note": "顶层混合状态文件，约 4–10 分钟整体重写一次；按 parts 分派层；其余 40+ 键由 uncovered 兜底"
        }
      ],
      "parts_uncovered": "keep",
      "parts": [
        {
          "id": "machine-identity",
          "selector": {
            "json_pointer": "/machineID"
          },
          "layer": "L4",
          "secret": "none",
          "extractor": "digest",
          "needed_by": [
            "daemon"
          ]
        },
        {
          "id": "user-identity",
          "selector": {
            "json_pointer": "/userID"
          },
          "layer": "L4",
          "secret": "none",
          "extractor": "digest"
        },
        {
          "id": "project-index",
          "selector": {
            "json_pointer": "/projects"
          },
          "layer": "L4",
          "secret": "none",
          "extractor": "keys-only",
          "path_semantics": "machine_derived",
          "derived_from": "json_path_key",
          "notes": "43 个绝对路径键；每键产出 origin，供 slug 目录反查；本机 0/43 含 history"
        },
        {
          "id": "project-history",
          "selector": {
            "json_pointer": "/projects/*/history"
          },
          "layer": "L3",
          "secret": "scan",
          "extractor": "template",
          "max_bytes_inline": 65536,
          "redact": {
            "key_pattern": [
              "(?i).*(token|secret|password|api[_-]?key).*"
            ]
          }
        },
        {
          "id": "mcp-servers",
          "selector": {
            "json_pointer": "/mcpServers"
          },
          "layer": "L2",
          "secret": "scan",
          "extractor": "template",
          "max_bytes_inline": 65536,
          "redact": {
            "key_pattern": [
              "(?i).*(token|secret|password|api[_-]?key).*"
            ]
          }
        }
      ]
    },
    {
      "id": "projects-transcripts",
      "kind": "glob-group",
      "root": "home",
      "paths": [
        ".claude/projects/**/*.jsonl"
      ],
      "layer": "L3",
      "secret": "scan",
      "extractor": "digest",
      "sessions": true,
      "opaque_content": true,
      "max_bytes_inline": 0,
      "max_bytes_total": 2147483648,
      "path_semantics": "machine_derived",
      "derived_from": "repo_slug",
      "priority": 10,
      "signals": [
        {
          "src": "official_docs",
          "note": "会话 transcript 以 JSONL 逐条追加，记录读过的全部内容",
          "url": "https://code.claude.com/docs/en/memory"
        },
        {
          "src": "observed_behavior",
          "note": "本机 projects 目录 4.8 GB，单文件最大 86 MB"
        }
      ]
    },
    {
      "id": "projects-tool-results",
      "kind": "glob-group",
      "root": "home",
      "paths": [
        ".claude/projects/**/tool-results/**"
      ],
      "layer": "L3",
      "secret": "scan",
      "extractor": "digest",
      "sessions": true,
      "opaque_content": true,
      "max_bytes_inline": 0,
      "max_bytes_total": 536870912,
      "path_semantics": "machine_derived",
      "derived_from": "repo_slug",
      "priority": 20,
      "signals": [
        {
          "src": "observed_behavior",
          "note": "webfetch/tool-result 的 PDF 与文本附件，transcript 的 tool_result 引用指向它们，删后 /resume 回放缺内容"
        }
      ]
    },
    {
      "id": "projects-subagents",
      "kind": "glob-group",
      "root": "home",
      "paths": [
        ".claude/projects/**/subagents/**/*.jsonl"
      ],
      "layer": "L3",
      "secret": "scan",
      "extractor": "digest",
      "sessions": true,
      "max_bytes_inline": 65536,
      "path_semantics": "machine_derived",
      "derived_from": "repo_slug",
      "priority": 20,
      "signals": [
        {
          "src": "observed_behavior",
          "note": "子代理会话记录，与主 transcript 同属会话状态"
        }
      ]
    },
    {
      "id": "projects-memory",
      "kind": "glob-group",
      "root": "home",
      "paths": [
        ".claude/projects/**/memory/**"
      ],
      "layer": "L3",
      "secret": "scan",
      "extractor": "template",
      "priority": 15,
      "path_semantics": "machine_derived",
      "derived_from": "repo_slug",
      "max_bytes_inline": 262144,
      "max_bytes_total": 268435456,
      "signals": [
        {
          "src": "observed_behavior",
          "note": "Claude Code 记忆文件，按项目 slug 存放，是唯一不可再生的长期记忆"
        }
      ]
    },
    {
      "id": "history",
      "kind": "file",
      "root": "home",
      "path": ".claude/history.jsonl",
      "layer": "L3",
      "secret": "scan",
      "extractor": "template",
      "priority": 10,
      "redact": {
        "key_pattern": [
          "(?i).*(token|secret|password|api[_-]?key).*"
        ]
      },
      "signals": [
        {
          "src": "observed_behavior",
          "note": "用户输入历史，明文"
        }
      ]
    },
    {
      "id": "todos",
      "kind": "dir",
      "root": "home",
      "path": ".claude/todos",  // 本机不存在
      "layer": "L0",
      "secret": "none",
      "extractor": "none",
      "expand": "aggregate",
      "signals": [
        {
          "src": "observed_behavior",
          "note": "会话级待办快照，可随会话重建"
        }
      ]
    },
    {
      "id": "shell-snapshots",
      "kind": "dir",
      "root": "home",
      "path": ".claude/shell-snapshots",
      "layer": "L0",
      "secret": "none",
      "extractor": "none",
      "expand": "aggregate",
      "signals": [
        {
          "src": "observed_behavior",
          "note": "shell 快照，启动时重新生成"
        }
      ]
    },
    {
      "id": "cache-debug-statsig-ide",
      "kind": "glob-group",
      "root": "home",
      "paths": [  // statsig、ide 本机不存在
        ".claude/cache/**",
        ".claude/debug/**",
        ".claude/statsig/**",
        ".claude/ide/**"
      ],
      "layer": "L0",
      "secret": "none",
      "extractor": "none",
      "expand": "aggregate",
      "priority": 5,
      "signals": [
        {
          "src": "observed_behavior",
          "note": "缓存、调试日志、特性开关缓存与 IDE 锁文件，均可再生"
        }
      ]
    },
    {
      "id": "global-claude-md",
      "kind": "file",
      "root": "home",
      "path": ".claude/CLAUDE.md",
      "layer": "L2",
      "secret": "none",
      "extractor": "raw-ref",
      "unique_within": "root",
      "priority": 10,
      "signals": [
        {
          "src": "official_docs",
          "note": "全局用户级记忆/规则文件",
          "url": "https://code.claude.com/docs/en/memory"
        }
      ]
    },
    {
      "id": "skills",
      "kind": "dir",
      "root": "home",
      "path": ".claude/skills",  // 本机不存在
      "layer": "L3",
      "secret": "scan",
      "extractor": "template",
      "redact": {
        "key_pattern": [
          "(?i).*(token|secret|password|api[_-]?key).*"
        ]
      },
      "signals": [
        {
          "src": "official_docs",
          "note": "用户自定义 skill，多为手写且无上游",
          "url": "https://code.claude.com/docs/en/skills"
        }
      ]
    },
    {
      "id": "agents",
      "kind": "dir",
      "root": "home",
      "path": ".claude/agents",
      "layer": "L3",
      "secret": "none",
      "extractor": "raw-ref",
      "signals": [
        {
          "src": "observed_behavior",
          "note": "用户级子代理定义，手写且无上游；本机 3 个"
        }
      ]
    },
    {
      "id": "plugins-readme",
      "kind": "file",
      "root": "home",
      "path": ".claude/plugins/README.md",
      "layer": "L1",
      "secret": "none",
      "extractor": "raw-ref",
      "priority": 1,
      "signals": [
        {
          "src": "observed_behavior",
          "note": "插件目录说明；不再设整目录条目，未列出的插件文件交给 home 的 .claude catch-all"
        }
      ]
    },
    {
      "id": "plugins-known-marketplaces",
      "kind": "file",
      "root": "home",
      "path": ".claude/plugins/known_marketplaces.json",
      "layer": "L2",
      "secret": "none",
      "extractor": "keys-only",
      "priority": 20,
      "signals": [
        {
          "src": "observed_behavior",
          "note": "已登记 marketplace 列表，528 B；重装可由清单重建但需重加来源"
        }
      ]
    },
    {
      "id": "plugins-directory-cache",
      "kind": "file",
      "root": "home",
      "path": ".claude/plugins/plugin-directory-cache-v2.json",
      "layer": "L0",
      "secret": "none",
      "extractor": "keys-only",
      "max_bytes_inline": 0,
      "max_bytes_structure": 4194304,
      "signals": [
        {
          "src": "observed_behavior",
          "note": "marketplace 目录索引缓存，本机 2,754,173 B，可重新拉取"
        }
      ]
    },
    {
      "id": "plugins-heartbeat",
      "kind": "glob-group",
      "root": "home",
      "paths": [
        ".claude/plugins/*/heartbeat.json",
        ".claude/plugins/*/heartbeat.json.*"
      ],
      "layer": "L0",
      "secret": "none",
      "extractor": "none",
      "priority": 5,
      "signals": [
        {
          "src": "observed_behavior",
          "note": "插件守护进程心跳；本机 28 个 heartbeat.json.<pid>.tmp"
        }
      ]
    },
    {
      "id": "plugins-stripped",
      "kind": "glob-group",
      "root": "home",
      "paths": [
        ".claude/plugins/*/stripped/**"
      ],
      "layer": "L0",
      "secret": "none",
      "extractor": "none",
      "expand": "aggregate",
      "signals": [
        {
          "src": "observed_behavior",
          "note": "插件代码的裁剪副本，可由插件包重建"
        }
      ]
    },
    {
      "id": "plugins-statusline",
      "kind": "glob-group",
      "root": "home",
      "paths": [
        ".claude/plugins/*/statusline.cmd",
        ".claude/plugins/*/statusline.mjs",
        ".claude/plugins/*/previous-statusline.txt"
      ],
      "layer": "L0",
      "secret": "none",
      "extractor": "none",
      "signals": [
        {
          "src": "observed_behavior",
          "note": "插件自带状态栏脚本与上次输出，随插件重装"
        }
      ]
    },
    {
      "id": "plugins-last-sweep",
      "kind": "file",
      "root": "home",
      "path": ".claude/plugins/.last_inuse_sweep",
      "layer": "L0",
      "secret": "none",
      "extractor": "none",
      "signals": [
        {
          "src": "observed_behavior",
          "note": "插件清理时间戳，隐藏文件"
        }
      ]
    },
    {
      "id": "plugins-cache",
      "kind": "glob-group",
      "root": "home",
      "paths": [
        ".claude/plugins/cache/**"
      ],
      "layer": "L0",
      "secret": "none",
      "extractor": "none",
      "expand": "aggregate",
      "priority": 10,
      "signals": [
        {
          "src": "observed_behavior",
          "note": "插件安装副本，可凭清单重下"
        }
      ]
    },
    {
      "id": "plugins-marketplaces",
      "kind": "glob-group",
      "root": "home",
      "paths": [
        ".claude/plugins/marketplaces/**"
      ],
      "layer": "L1",
      "secret": "none",
      "extractor": "keys-only",
      "expand": "aggregate",
      "priority": 10,
      "signals": [
        {
          "src": "observed_behavior",
          "note": "marketplace 的完整 git 克隆，可重新克隆；.git 由默认 exclude 排除"
        }
      ]
    },
    {
      "id": "plugins-enabled",
      "kind": "glob-group",
      "root": "home",
      "paths": [
        ".claude/plugins/enabled*.json",
        ".claude/plugins/installed_plugins.json"
      ],
      "layer": "L2",
      "secret": "none",
      "extractor": "keys-only",
      "priority": 20,
      "signals": [
        {
          "src": "observed_behavior",
          "note": "插件启用清单；启用状态同时存在于 settings.json 的 enabledPlugins，故 L2"
        }
      ]
    },
    {
      "id": "plugins-config",
      "kind": "glob-group",
      "root": "home",
      "paths": [
        ".claude/plugins/*/config.json"
      ],
      "layer": "L2",
      "secret": "scan",
      "extractor": "template",
      "priority": 20,
      "redact": {
        "key_pattern": [
          "(?i).*(token|secret|password|api[_-]?key).*"
        ]
      },
      "signals": [
        {
          "src": "observed_behavior",
          "note": "插件显示项等用户偏好，重装插件不会带回"
        }
      ]
    },
    {
      "id": "plugins-store",
      "kind": "dir",
      "root": "home",
      "path": ".claude/plugins/store",
      "layer": "L3",
      "secret": "none",
      "extractor": "keys-only",
      "priority": 10,
      "signals": [
        {
          "src": "observed_behavior",
          "note": "插件运行时持久状态，无上游"
        }
      ]
    },
    {
      "id": "plugins-data",
      "kind": "glob-group",
      "root": "home",
      "paths": [
        ".claude/plugins/**/data/**"
      ],
      "layer": "L0",
      "secret": "none",
      "extractor": "none",
      "expand": "aggregate",
      "priority": 10,
      "signals": [
        {
          "src": "observed_behavior",
          "note": "插件游标等可重建数据，如 transcript-cursors"
        }
      ]
    },
    {
      "id": "file-history",
      "kind": "dir",
      "root": "home",
      "path": ".claude/file-history",
      "layer": "L0",
      "secret": "none",
      "extractor": "none",
      "expand": "aggregate",
      "needed_by": [
        "rewind"
      ],
      "signals": [
        {
          "src": "observed_behavior",
          "note": "文件编辑检查点，删后旧会话 /rewind 回不到旧版本；本机 268 个 @vN 快照"
        }
      ]
    },
    {
      "id": "statusline",
      "kind": "file",
      "root": "home",
      "path": ".claude/statusline.js",
      "layer": "L2",
      "secret": "none",
      "extractor": "raw-ref",
      "needed_by": [
        "statusline"
      ],
      "priority": 10,
      "signals": [
        {
          "src": "observed_behavior",
          "note": "被 settings.json 的 statusLine.command 引用"
        }
      ]
    },
    {
      "id": "backups",
      "kind": "glob-group",
      "root": "home",
      "paths": [
        ".claude/backups/.*"
      ],
      "layer": "L2",
      "secret": "scan",
      "extractor": "template",
      "redact": {
        "key_pattern": [
          "(?i).*(token|secret|password|api[_-]?key).*"
        ]
      },
      "signals": [
        {
          "src": "observed_behavior",
          "note": ".claude.json 的自动备份，隐藏文件，需显式匹配 . 段"
        }
      ]
    },
    {
      "id": "sessions",
      "kind": "glob-group",
      "root": "home",
      "paths": [
        ".claude/sessions/**"
      ],
      "layer": "L0",
      "secret": "scan",
      "extractor": "digest",
      "opaque_content": true,
      "max_bytes_inline": 0,
      "needed_by": [
        "daemon"
      ],
      "signals": [
        {
          "src": "observed_behavior",
          "note": "每进程会话密钥与状态，108 B 的 *.key 由 daemon 引用，进程重启可再生"
        }
      ]
    },
    {
      "id": "keybindings",
      "kind": "file",
      "root": "home",
      "path": ".claude/keybindings.json",
      "layer": "L2",
      "secret": "none",
      "extractor": "raw-ref",
      "signals": [
        {
          "src": "official_docs",
          "note": "自定义键位",
          "url": "https://code.claude.com/docs/en/keybindings"
        }
      ]
    },
    {
      "id": "oauth-credential-store",
      "kind": "named-location",
      "os": [
        "darwin",
        "windows",
        "linux"
      ],
      "locator": {
        "darwin": "keychain:generic-password?service=Claude Code-credentials",
        "windows": "wincred:Claude Code-credentials",  // TODO verify 目标名
        "linux": "file:$HOME/.claude/.credentials.json"  // TODO verify
      },
      "probe": {
        "darwin": "keychain",
        "windows": "wincred",
        "linux": "file-probe"
      },
      "layer": "L5",
      "secret": "relogin",
      "extractor": "digest",
      "signals": [
        {
          "src": "official_docs",
          "note": "OAuth 凭据存于系统凭据库；换机需重新登录",
          "url": "https://code.claude.com/docs/en/setup"
        }
      ]
    },
    {
      "id": "repo-settings-local",
      "kind": "file",
      "root": "repo",
      "path": ".claude/settings.local.json",
      "layer": "L2",
      "secret": "scan",
      "extractor": "template",
      "unique_within": "root",
      "priority": 20,
      "redact": {
        "key_pattern": [
          "(?i).*(token|secret|password|api[_-]?key).*"
        ]
      },
      "signals": [
        {
          "src": "observed_behavior",
          "note": "项目本地覆盖，被 .claude/* 类 gitignore 排除，从未进版本库"
        }
      ]
    },
    {
      "id": "repo-mcp-json",
      "kind": "file",
      "root": "repo",
      "path": ".mcp.json",  // 本机不存在
      "layer": "L2",
      "secret": "scan",
      "extractor": "template",
      "priority": 20,
      "redact": {
        "key_pattern": [
          "(?i).*(token|secret|password|api[_-]?key).*"
        ]
      },
      "signals": [
        {
          "src": "official_docs",
          "note": "项目级 MCP server 定义，env 中常含明文 token",
          "url": "https://code.claude.com/docs/en/mcp"
        }
      ]
    },
    {
