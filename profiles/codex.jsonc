        "root": "codex",
        "match": "logs_2.sqlite",
        "layer": "L2",
        "risk_flags": [
          "opaque_content"
        ]
      },
      {
        "entry": "sqlite-thread-history",
        "root": "codex",
        "match": "thread_history_1.sqlite",
